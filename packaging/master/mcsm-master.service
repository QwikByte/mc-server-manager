[Unit]
Description=MC Server Manager master
Documentation=https://github.com/QwikByte/mc-server-manager
After=network-online.target
Wants=network-online.target mcsm-master-update.path

[Service]
User=mcsm
Group=mcsm
EnvironmentFile=-/etc/mcsm/master.env
ExecStart=/usr/bin/mcsm-master --data-dir /var/lib/mcsm-master serve --restart-exit-code 75 $MCSM_MASTER_OPTS
# Administrators restart the master from the panel: it stops and exits with 75, then
# systemd starts it again, also reading master.env again.
SuccessExitStatus=75
RestartForceExitStatus=75
StateDirectory=mcsm-master
StateDirectoryMode=0700
LogsDirectory=mcsm-master
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
# Only to listen at ports below 1024, e.g. 443 for HTTPS and 80 for Let's Encrypt.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
