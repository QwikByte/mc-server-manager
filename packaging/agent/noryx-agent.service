[Unit]
Description=Noryx agent
Documentation=https://github.com/QwikByte/noryx
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
# Access to the Docker socket is equivalent to root, so the agent runs as root.
EnvironmentFile=-/etc/noryx/agent.env
ExecStart=/usr/bin/noryx-agent --data-dir /var/lib/noryx-agent serve $NORYX_AGENT_OPTS
StateDirectory=noryx-agent
StateDirectoryMode=0700
LogsDirectory=noryx-agent
LogsDirectoryMode=0700
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
