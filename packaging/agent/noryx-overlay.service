[Unit]
Description=Noryx private network of the nodes
Documentation=https://github.com/QwikByte/noryx
# Docker starts the backends whose ports are published at the node's address in the network,
# which only works once the interface has it.
Before=docker.service noryx-agent.service
ConditionPathExists=/var/lib/noryx-agent/overlay/state.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-modprobe wireguard
ExecStart=/usr/bin/noryx-agent --data-dir /var/lib/noryx-agent overlay up

[Install]
WantedBy=multi-user.target
