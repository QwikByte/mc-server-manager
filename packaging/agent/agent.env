# Options of the agent service, see: mcsm-agent serve --help
# Apply changes with: systemctl restart mcsm-agent
#
#   --listen           where the master connects to; allow this port only from the master's IP
#   --log-format json  for log collectors
#   --log-file /var/log/mcsm-agent/agent.log
MCSM_AGENT_OPTS="--listen :7443"
